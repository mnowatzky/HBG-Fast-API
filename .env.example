# Production: copy to .env next to docker-compose.yml (chmod 600) and fill in.
# Keep a copy of this file somewhere safe.

# Release versions to run. The two repositories release independently.
API_TAG=0.1.0
FRONTEND_TAG=0.1.0

# The Docker network of your reverse proxy.
PROXY_NETWORK=

STICKER_DB_HOST=sticker-db
STICKER_DB_PORT=5432
STICKER_DB_USER=sticker
# openssl rand -hex 32
STICKER_DB_PASSWORD=
STICKER_DB_NAME=sticker
STICKER_DB_TYPE=postgresql

# The path the proxy serves the API below, used for the links in /docs.
STICKER_ROOT_PATH=/api

# Only needed when the frontend calls the API from another origin. JSON list.
# STICKER_CORS_ORIGINS=["https://intern.diehbg.de"]

# New stickers per client IP.
# STICKER_CREATE_RATE_LIMIT=5/minute;50/day
